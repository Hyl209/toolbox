{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyl Toolbox",
  "version": "0.1.0",
  "identifier": "com.admin.desktop-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hyl Toolbox",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../dist/hyl_sidecar/hyl_sidecar.exe": "hyl_sidecar.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
